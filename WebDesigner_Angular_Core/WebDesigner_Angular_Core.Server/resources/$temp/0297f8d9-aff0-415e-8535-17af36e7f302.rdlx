			<Name>PaperOrientation</Name>
			<Value>Portrait</Value>
		</CustomProperty>
		<CustomProperty>
			<Name>CollapseWhiteSpace</Name>
			<Value>True</Value>
		</CustomProperty>
	</CustomProperties>
</Report>